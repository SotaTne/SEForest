---
config:
  layout: elk
  class:
    defaultRenderer: elk
    nodeSpacing: 55
    rankSpacing: 80
---
classDiagram
direction TB
%% display-width: 48%
%% display-height: 520px

class Model

class NodeEditorPopupView {
  -model: Model
  -popupWidget: object
  -textEntry: object
  +show(state: NodeEditorState) None
  +hide() None
  +draftText() str
  -onSelectionChanged() None
  -onEditorChanged() None
}

class CanvasPopupView {
  -popupWidget: object
  +show(position: Point) None
  +hide() None
}

class DesktopView {
  -model: Model
  -rootWindow: object
  -canvas: object
  -nodeEditorPopupView: NodeEditorPopupView
  -canvasPopupView: CanvasPopupView
  -controller: Controller
  +bindController(controller: Controller) None
  +showFilePrompt() None
  +chooseInputFile() Path | None
  +chooseOutputFile() Path | None
  +renderCanvas() None
  +renderPlaybackControls() None
  +nodeAt(viewPoint: Point) BaseNode | None
  -onNodesChanged() None
  -onLayoutChanged() None
  -onSelectionChanged() None
  -onPlaybackChanged() None
  -onDesktopChanged() None
  -drawEdges() None
  -drawNodes() None
}

class Controller {
  -model: Model
  -view: DesktopView
  -pressPoint: Point | None
  -lastDragPoint: Point | None
  -isDragging: bool
  -playbackJobId: str | None
  +openFile(inputPath: Path) None
  +handleDrop(paths: list~Path~) None
  +handlePointerPress(point: Point) None
  +handlePointerMove(point: Point) None
  +handlePointerRelease(point: Point) None
  +handleWheel(deltaX: float, deltaY: float) None
  +handleZoom(anchor: Point, scaleDelta: float) None
  +handleNodeClick(node: BaseNode, point: Point) None
  +handleCanvasClick() None
  +confirmRename(text: str) None
  +cancelPopup() None
  +togglePlayback() None
  +showPreviousStep() None
  +showNextStep() None
  +seekStep(index: int) None
  -scheduleNextStep() None
  -cancelScheduledStep() None
}

class ForestApp {
  -model: Model
  -desktopView: DesktopView
  -controller: Controller
  +build() None
  +run() None
}

DesktopView ..> Model : reads
NodeEditorPopupView ..> Model : reads
DesktopView *-- NodeEditorPopupView : popup
DesktopView *-- CanvasPopupView : popup
Controller --> Model : updates
Controller --> DesktopView : controls
ForestApp *-- Model : model
ForestApp *-- DesktopView : view
ForestApp *-- Controller : controller

note for DesktopView "メイン画面とCanvasを表示"
note for NodeEditorPopupView "ノード編集と部分画像出力の小窓"
note for CanvasPopupView "Canvas全体の画像出力小窓"
note for Controller "画面イベントをModelの操作へ変換"
note for ForestApp "MVC各要素を構成して起動"

classDef mvc fill:#eaf2ff,stroke:#54749f,color:#20334d,stroke-width:1.5px
cssClass "Model,NodeEditorPopupView,CanvasPopupView,DesktopView,Controller,ForestApp" mvc
